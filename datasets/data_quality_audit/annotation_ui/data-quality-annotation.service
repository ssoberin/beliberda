[Unit]
Description=Local blind annotation UI for Avito data quality audit
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/Hakaton/innopolis_2026/datasets/data_quality_audit/annotation_ui
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
UMask=0077
ExecStart=/srv/Hakaton/data-quality-ui-venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --server.fileWatcherType none --browser.gatherUsageStats false
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
