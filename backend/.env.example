# Qwen must serve an OpenAI-compatible HTTP API (vLLM, for example).
# First TF-IDF baseline, stored outside Git. File SHA-256 is checked before loading.
# CLASSIFIER_MODEL_PATH=/srv/Hakaton/models/baseline/tfidf_baseline.joblib
CLASSIFIER_MODEL_PATH=
QWEN_MODEL=avito-qwen
QWEN_API_KEY=
# Optional override. Include /v1; do not put API keys into the URL.
# QWEN_BASE_URL=http://127.0.0.1:18000/v1
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_TOKENS=4096
QWEN_MAX_CONCURRENT_REQUESTS=2
# json_object, json_schema, or none, depending on the remote server.
QWEN_RESPONSE_FORMAT=json_object
# vLLM /tokenize: budget input, few-shot examples and output together.
QWEN_TOKENIZE_BEFORE_GENERATE=1

# Blank target: use a manually started tunnel or a directly reachable API.
# With SSH_TARGET set, backend owns the tunnel for its entire lifespan.
SSH_TARGET=
# Blank: respect the SSH config alias; OpenSSH defaults to port 22.
SSH_PORT=
SSH_LOCAL_PORT=18000
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=8000
# Optional; otherwise ssh-agent and ~/.ssh/config are used.
SSH_IDENTITY_FILE=
SSH_STARTUP_TIMEOUT_SECONDS=15

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
